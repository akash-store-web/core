{
  "info": {
    "name": "Akash Store API",
    "description": "Colección de pruebas del backend de Akash Store. Guía completa: `docs/API.md`.\n\n1. Importa la colección y un entorno (Render o Local).\n2. En el entorno, completa `email` y `password` (valor actual, NO el inicial: así no se exporta).\n3. Ejecuta **1. Auth / Login**: el token se guarda solo.\n\n⚠️ El entorno Render usa la base real de Supabase: las peticiones marcadas escriben datos reales. Usa nombres con 'QA' y despublica lo que crees.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "producto_id",
      "value": "1"
    },
    {
      "key": "variante_id",
      "value": "1"
    },
    {
      "key": "imagen_id",
      "value": "1"
    },
    {
      "key": "zona_id",
      "value": "1"
    },
    {
      "key": "distrito_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0. Estado",
      "description": "Ejecútalo primero: Render gratuito se duerme y la primera respuesta puede tardar ~50 s.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Debe responder {\"status\": \"ok\"}.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "1. Auth",
      "description": "Primero ejecuta **Login**: guarda el token y todas las rutas del panel lo usan solas.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Usa las variables `email` y `password` del entorno. Guarda `access_token` en `{{token}}`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login correcto\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", datos.access_token);",
                  "console.log(\"Token guardado en la variable {{token}} (dura 30 minutos)\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con credenciales inválidas (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Debe responder 401 sin decir qué campo falló.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Recuperar contraseña",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/recuperar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "recuperar"
              ]
            },
            "description": "Siempre 202, exista o no el correo. ⚠️ Si el correo existe, Brevo envía un correo real.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Restablecer contraseña",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/restablecer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "restablecer"
              ]
            },
            "description": "El token sale del enlace `.../restablecer?token=...`. Vence en 30 min y sirve una vez. ⚠️ Escribe en la base del entorno elegido.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<pega aquí el token del enlace del correo>\",\n  \"nueva_contrasena\": \"nueva-clave-segura\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Cambiar contraseña (con sesión)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/contrasena",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "contrasena"
              ]
            },
            "description": "⚠️ Cambia la contraseña real de la cuenta del entorno. Después actualiza `password` en el entorno.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actual\": \"{{password}}\",\n  \"nueva\": \"nueva-clave-segura\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Catálogo (público)",
      "description": "Sin login. Solo productos publicados; nunca muestra existencias exactas.",
